# URL de l'API (suffixe /api). Par défaut : l'API de production.
# Pour un backend local : http://<IP-de-votre-machine>:8000/api (pas localhost depuis un téléphone).
EXPO_PUBLIC_API_URL=https://web-production-d1aa3.up.railway.app/api

# Connexion Google (build de développement ou de production, pas Expo Go) :
# ID client OAuth « Application Web » (le même que GOOGLE_CLIENT_ID du backend)
# et ID client « iOS » (Google Cloud Console › Identifiants). Vides → bouton masqué.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-ios.apps.googleusercontent.com

# Connexion Apple hors iPhone (Android) : Services ID Apple, le même que APPLE_SERVICES_ID
# du backend. Vide → le bouton Apple affiche « pas encore configurée » sur Android.
# EXPO_PUBLIC_APPLE_SERVICES_ID=com.alternly.app.signin
