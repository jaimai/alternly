{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }, "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }, "continue": true
    },
    { "src": "/", "dest": "https://web-production-d1aa3.up.railway.app/" },
    { "src": "/en", "dest": "https://web-production-d1aa3.up.railway.app/en" },
    { "src": "/en/blog", "dest": "https://web-production-d1aa3.up.railway.app/en/blog" },
    { "src": "/en/blog/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/en/blog/$1" },
    { "src": "/blog", "dest": "https://web-production-d1aa3.up.railway.app/blog" },
    { "src": "/blog/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/blog/$1" },
    { "src": "/outils", "dest": "https://web-production-d1aa3.up.railway.app/outils" },
    { "src": "/outils/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/outils/$1" },
    { "src": "/api/public/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/api/public/$1" },
    { "src": "/api/email/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/api/email/$1" },
    { "src": "/terms", "dest": "https://web-production-d1aa3.up.railway.app/terms" },
    { "src": "/privacy", "dest": "https://web-production-d1aa3.up.railway.app/privacy" },
    { "src": "/refund", "dest": "https://web-production-d1aa3.up.railway.app/refund" },
    { "src": "/en/(terms|privacy|refund)", "dest": "https://web-production-d1aa3.up.railway.app/en/$1" },
    { "src": "/robots.txt", "dest": "https://web-production-d1aa3.up.railway.app/robots.txt" },
    { "src": "/sitemap.xml", "dest": "https://web-production-d1aa3.up.railway.app/sitemap.xml" },
    { "src": "/llms.txt", "dest": "https://web-production-d1aa3.up.railway.app/llms.txt" },
    { "src": "/static/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/static/$1" },
    { "src": "/ical/(.*)", "dest": "https://web-production-d1aa3.up.railway.app/api/ical/$1" },
    { "src": "/ingest/static/(.*)", "dest": "https://eu-assets.i.posthog.com/static/$1" },
    { "src": "/ingest/(.*)", "dest": "https://eu.i.posthog.com/$1" },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdn.paddle.com https://*.paddle.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://accounts.google.com/gsi/style; font-src 'self' data:; img-src 'self' data: https://*.paddle.com https://*.googleusercontent.com; connect-src 'self' https:; frame-src https://*.paddle.com https://accounts.google.com/gsi/; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
      }, "dest": "/index.html"
    }
  ]
}
