# PostgreSQL alwaysdata (fourni par Thomas) — sinon fallback SQLite local
# DATABASE_URL=postgresql+psycopg://user:password@postgresql-xxx.alwaysdata.net/dbname
SECRET_KEY=change-me-in-production

# URL publique de la SPA (Vercel) + origines CORS autorisées (séparées par des virgules)
# APP_URL=https://app.alternly.com
# CORS_ORIGINS=https://app.alternly.com

# Notifications e-mail (Resend). Laisser RESEND_API_KEY vide désactive l'envoi (no-op).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Alternly <no-reply@alternly.com>

# Rappels d'échange : secret protégeant POST /api/cron/exchange-reminders.
# CRON_SECRET=une-chaine-aleatoire-longue

# Paiement Paddle (Merchant of Record)
# TRIAL_DAYS=14
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...   # secret de signature des webhooks Paddle
# PADDLE_API_KEY=pdl_apikey_...          # optionnel (appels API serveur)

# --- Côté Vercel (variables VITE_, au build de la SPA) ---
# VITE_API_URL=https://<backend>/api
# VITE_PADDLE_CLIENT_TOKEN=live_xxx  (ou test_xxx en sandbox)
# VITE_PADDLE_PRICE_ID=pri_xxx       (prix annuel 39 € créé dans Paddle)
# VITE_PADDLE_ENV=production          (ou sandbox)
