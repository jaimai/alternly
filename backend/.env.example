# PostgreSQL alwaysdata (fourni par Thomas) — sinon fallback SQLite local
# DATABASE_URL=postgresql+psycopg://user:password@postgresql-xxx.alwaysdata.net/dbname
# Clé de signature JWT : ≥ 32 caractères aléatoires, refusée si faible hors SQLite.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Mono-domaine : Vercel sert la SPA et proxifie le site marketing vers Railway.
# APP_URL : origine de la SPA (liens e-mails, invitations /join/…, /reset-password).
# PUBLIC_SITE_URL : origine publique du site (canonical, sitemap, robots, llms.txt).
# CORS_ORIGINS : origines autorisées à appeler l'API (séparées par des virgules).
# APP_URL=https://alternly.com
# PUBLIC_SITE_URL=https://alternly.com
# CORS_ORIGINS=https://alternly.com

# Notifications e-mail (Resend). Laisser RESEND_API_KEY vide désactive l'envoi (no-op).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Alternly <no-reply@alternly.com>

# Rappels d'échange : secret protégeant POST /api/cron/exchange-reminders.
# CRON_SECRET=une-chaine-aleatoire-longue

# Limitation de débit anti-abus (mémoire du processus). false = coupée (incident uniquement).
# RATE_LIMIT_ENABLED=true

# Suivi d'erreurs Sentry (optionnel, région UE recommandée)
# SENTRY_DSN=https://xxx@o0.ingest.de.sentry.io/0

# « Continuer avec Google » : ID client OAuth (type Application Web). Vide → désactivé.
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# App mobile : ID clients OAuth iOS et Android, séparés par des virgules.
# GOOGLE_MOBILE_CLIENT_IDS=1234567890-ios.apps.googleusercontent.com,1234567890-android.apps.googleusercontent.com
# « Se connecter avec Apple » (iPhone) : identifiant de bundle. Par défaut com.alternly.app ;
# ajouter host.exp.Exponent pour tester dans Expo Go, sur un backend local UNIQUEMENT (jamais
# en production : n'importe quel projet Expo Go obtient des jetons pour cette audience). Vide → désactivé.
# APPLE_CLIENT_IDS=com.alternly.app
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Mesure d'audience PostHog (UE). Vide → désactivé. Voir docs/analytics.md.
# POSTHOG_TOKEN=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_SERVER_LOGS=false

# Paiement Paddle (Merchant of Record)
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...   # signature des webhooks (REQUIS pour activer les abos)
# PADDLE_API_KEY=pdl_apikey_... / pdl_sdbx_apikey_...  # appels API serveur (optionnel)
# PADDLE_ENV=sandbox                     # ou production
# PADDLE_PRICE_ANNUAL=pri_...            # changement d'offre / offre courante
# PADDLE_PRICE_MONTHLY=pri_...

# --- Côté Vercel / frontend (variables VITE_, au build de la SPA) ---
# VITE_API_URL=https://<backend>/api
# VITE_POSTHOG_KEY=phc_...            # même valeur que POSTHOG_TOKEN
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com  # même valeur que GOOGLE_CLIENT_ID
# VITE_PADDLE_ENV=sandbox                # ou production
# VITE_PADDLE_CLIENT_TOKEN=test_xxx      # Dashboard → Developer Tools → Client-side tokens
# Prix créés dans le sandbox (produit « Alternly Premium », dédié) :
# VITE_PADDLE_PRICE_ID=pri_01kyq2gyqj4mv2pr8kc3ksq20j          # annuel 69 € / $79
# VITE_PADDLE_PRICE_ID_MONTHLY=pri_01kyq2gz0nck7fy45nas7zkzac  # mensuel 8,99 € / $8.99
