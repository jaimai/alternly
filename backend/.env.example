# Base de données : PostgreSQL en production (Railway fournit DATABASE_URL,
# `postgres://…` est accepté). Absente → fallback SQLite local.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Clé de signature des jetons JWT. OBLIGATOIRE hors SQLite (≥ 32 caractères,
# le démarrage échoue sinon). Générer avec :
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL publique de la SPA (Vercel) : CTAs de la landing, liens e-mail et d'invitation.
# APP_URL=https://app.votre-domaine.fr
# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# CORS_ORIGINS=https://app.votre-domaine.fr
# URL publique canonique du site marketing (sitemap, robots, canonical, og:url).
# Vide → déduite de la requête.
# SITE_URL=https://votre-domaine.fr

# Notifications e-mail (Resend). Laisser RESEND_API_KEY vide désactive l'envoi (no-op).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Alternly <no-reply@votre-domaine.fr>

# Rappels d'échange : secret protégeant POST /api/cron/exchange-reminders.
# Laisser vide désactive l'endpoint. À déclencher une fois/jour (planificateur externe).
# CRON_SECRET=une-chaine-aleatoire-longue
